{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SIPL",
  "scopeName": "source.sipl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": { "name": "comment.line.number-sign.sipl", "match": "#.*$" },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.sipl", "match": "\\b(begin|end|if|then|else|while|do|skip)\\b" },
        { "name": "keyword.operator.word.sipl", "match": "\\b(or|not|div)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.sipl", "match": ":=" },
        { "name": "keyword.operator.sipl", "match": "[+\\-*=>∨¬]" }
      ]
    },
    "numbers": { "name": "constant.numeric.integer.sipl", "match": "\\b[0-9]+\\b" },
    "identifiers": { "name": "variable.other.sipl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
  }
}
